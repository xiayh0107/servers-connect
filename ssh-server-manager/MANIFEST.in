include SKILL.md
include scripts/*.py scripts/build-ui
include scripts/bootstrap scripts/bootstrap.cmd scripts/serverctl scripts/serverctl.cmd
include contracts/*.json contracts/*.txt
recursive-include docs *.md
recursive-include references *.md
recursive-include tests *.py *.md
prune tests/ui/node_modules
prune tests/ui/test-results
prune tests/ui/playwright-report
prune tests/.pytest_cache
prune tests/manual/tmp
recursive-include frontend *.ts *.tsx *.css *.json *.mjs *.html *.md
prune frontend/dist
prune frontend/node_modules
prune frontend/test-results
prune frontend/playwright-report
