#!/bin/sh
# Development-only compatibility launcher for the React/TypeScript source.
set -eu
BUILD_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "${1:-build}" in
  build) exec npm --prefix "$BUILD_ROOT/frontend" run build ;;
  check) exec npm --prefix "$BUILD_ROOT/frontend" run check-build ;;
  *) echo "usage: scripts/build-ui [build|check]; edit frontend/src" >&2; exit 2 ;;
esac
